	partition Date = calculated
		mode: import
		source =
				ADDCOLUMNS(
				    CALENDAR(DATE(2024, 1, 1), DATE(2025, 12, 31)),
				    "Year", YEAR([Date]),
				    "Month", FORMAT([Date], "MMMM"),
				    "Month (Sort Order)", MONTH([Date]),
				    "Day", DAY([Date]),
				    "Day (Sort Order)", WEEKDAY([Date])
				)

